# Waveshare ESP32-S3-LCD-1.47 (non-touch, 16 MB flash).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# The encrypted drive seeks among records in backing files up to ~65 MiB.
# Cache read-only file cluster chains instead of walking the FAT on long seeks.
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=256
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_MBEDTLS_GCM_C=y

CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024

# Enable the board's 8 MB embedded octal PSRAM and add it to the heap. Without
# this the whole stack (Wi-Fi + LVGL + TinyUSB + HTTP) competes for ~512 KB of
# internal SRAM, and the dynamic USB-drive working allocation can fail. OCT mode
# matches the ESP32-S3R8 (AP Memory 8 MB) on this board; IGNORE_NOTFOUND lets the
# device still boot if PSRAM is somehow absent.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
